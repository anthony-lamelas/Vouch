# Copy to backend/.env. This is everything needed to run VOUCH locally.
# Anything not listed here has a working default (see backend/app/config.py).

# Postgres from `docker compose up -d db`.
DATABASE_URL=postgresql+psycopg://vouch:vouch@localhost:5432/vouch

# No login locally: the app acts as recruiter@vouch.local.
AUTH_DISABLED=true

# Make that local user own the Research & Development roles ("My roles") and the demo pipeline.
DEMO_RECRUITER_EMAIL=recruiter@vouch.local
DEMO_RECRUITER_NAME=Local Recruiter

# Slack, only if you want real DMs locally. Leave blank and messages are recorded but not sent.
# APP_BASE_URL must be reachable by Slack (e.g. an ngrok URL) for the links in the card.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEMO_USER_ID=
APP_BASE_URL=http://localhost:8000

# Token for POST /api/admin/reset-demo (reseed).
ADMIN_TOKEN=change-me
