# Copy to backend/.env for local development. Every value here is optional locally.

APP_ENV=local
APP_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://vouch:vouch@localhost:5432/vouch

# Auth. Leave AUTH_DISABLED=true to skip login locally. In production set the Supabase values.
AUTH_DISABLED=true
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Slack. Leave blank locally; messages are recorded in the Outreach panel but not sent.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEMO_USER_ID=

# LLM (optional). template = deterministic drafts; claude = tailored drafts with template fallback.
ANTHROPIC_API_KEY=
OUTREACH_MODE=template
REPLY_CLASSIFIER_MODE=keyword

# Admin token for POST /api/admin/reset-demo
ADMIN_TOKEN=change-me

# Seed knobs
SEED_RANDOM_SEED=42
SEED_CONTACT_COUNT=3000
SEED_EMPLOYEE_COUNT=40
DEMO_EMPLOYEE_EMAIL=
